<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Compilation">
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <PackageId>BGCS.Cpp2C</PackageId>
    <Authors>FLwolfy</Authors>
    <Description>C++ to C bridge code generation support for BindGen-CS.</Description>
    <PackageTags>interop;bindings;cpp;c</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/FLwolfy/BindGen-CS</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/FLwolfy/BindGen-CS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Label="Project dependencies">
    <ProjectReference Include="../BGCS.Core/BGCS.Core.csproj" />
    <ProjectReference Include="../BGCS.CppAst/BGCS.CppAst.csproj" />
    <ProjectReference Include="../BGCS.Intermediate/BGCS.Intermediate.csproj" />
  </ItemGroup>

  <ItemGroup Label="Package content">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
