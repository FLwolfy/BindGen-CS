<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Compilation">
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BGCSGeneratedRoot Condition="'$(BGCSGeneratedRoot)' == ''">../Generated</BGCSGeneratedRoot>
  </PropertyGroup>

  <ItemGroup Label="Project dependencies">
    <ProjectReference Include="../../../src/BGCS.Runtime/BGCS.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup Label="Generated source inputs">
    <Compile Include="$(BGCSGeneratedRoot)/*/managed/**/*.cs" LinkBase="Generated" />
  </ItemGroup>
</Project>
