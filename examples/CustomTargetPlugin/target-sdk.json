{
  "platformId": "windows",
  "architectureId": "x64",
  "abiId": "msvc",
  "triple": "x86_64-pc-windows-msvc",
  "byteOrder": "littleEndian",
  "requiresExplicitSdk": true,
  "supportsDynamicModules": true,
  "systemIncludeDirectories": [
    "sdk/include"
  ],
  "defines": [
    "PROFILE_VERSION=1"
  ],
  "sourceConventions": {
    "exportDecoration": "__declspec(dllexport)",
    "cdeclDecoration": "__cdecl",
    "callableAssertions": {
      "defaultCConvention": "Win64",
      "permitsDirectCallOnlyVoidIntrinsic": true
    }
  },
  "headerSearchPaths": []
}
