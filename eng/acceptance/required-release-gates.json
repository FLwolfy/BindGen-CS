{
  "schemaVersion": 1,
  "workflow": "ci.yml",
  "requiredJobNames": [
    "Generator baseline (Windows x64)",
    "Generator smoke (Linux x64)",
    "Generator smoke (macOS x64)"
  ],
  "requireAllObservedJobsSuccessful": true,
  "requireCleanFeatureInventory": true,
  "featureBaseline": "eng/acceptance/feature-baseline.json",
  "configurationBaseline": "eng/acceptance/configuration-baseline.json",
  "requiredFeatureEvidence": [
    {
      "artifact": "release-feature-evidence-linux-x64-gnu",
      "host": "linux-x64"
    },
    {
      "artifact": "release-feature-evidence-windows-x64-msvc",
      "host": "windows-x64"
    },
    {
      "artifact": "release-feature-evidence-macos-x64-darwin",
      "host": "macos-x64"
    }
  ],
  "requireProductPackageInstallation": true,
  "productPackageWorkflow": "packages.yml",
  "requiredProductPackageJobNames": [
    "Installed product baseline"
  ],
  "requiredProductEvidence": [
    {
      "artifact": "product-package-evidence-windows-2022",
      "hostRid": "win-x64"
    }
  ],
  "globalFeatureProofs": {},
  "scopeRemovals": "eng/acceptance/scope-removals.json",
  "productScope": "C/C++ source generation and binding Runtime only; repository jobs independently compile/link/run generated consumer fixtures. No shipped native build provider or Objective-C gate.",
  "evidencePolicy": {
    "functionalBaselineHost": "windows-x64",
    "platformSmokeHosts": [
      "linux-x64",
      "macos-x64"
    ],
    "applicationPublishChecks": "the existing Linux generator smoke job must run the explicit BrowserWasm extension aggregate-and-callback fixture in MonoWasm and AOT modes; broader NativeAOT and browser application certification remains an optional developer check",
    "targetedBrowserRegression": {
      "job": "Generator smoke (Linux x64)",
      "script": "scripts/test-wasm-bindings.py --targeted --no-build",
      "modes": [
        "MonoWasm",
        "AOT"
      ],
      "artifact": "optional-browser-regression-linux-x64",
      "scope": "generated aggregate calls and callbacks with the explicitly registered BrowserWasm extension; not full browser platform certification"
    },
    "productInstallationHost": "windows-x64",
    "fullPlatformCertification": false
  }
}
