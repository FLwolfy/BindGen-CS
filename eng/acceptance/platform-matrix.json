      "scope": "runtime-specific typed asset references and import module identity"
    },
    {
      "path": "tests/BGCS.NativeBuild.Tests/StaticArtifactTests.cs",
      "scope": "native binary identity, byte order and rejection of incompatible RID assumptions"
    },
