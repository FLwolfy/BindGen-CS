<Project>
  <PropertyGroup>
    <BGCSWorkerHostRid Condition="'$(BGCSWorkerHostRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</BGCSWorkerHostRid>
    <BGCSWorkerAssetManifest Condition="'$(BGCSWorkerAssetManifest)' == '' and '$(BGCSWorkerAssetSourceRoot)' != '' and '$(BGCSWorkerHostRid)' != ''">$(_BGCSPackageRoot)tools/clang-worker/manifests/$(BGCSWorkerHostRid).json</BGCSWorkerAssetManifest>
    <BGCSNativePackageRoot Condition="'$(BGCSNativePackageRoot)' == '' and '$(BGCSWorkerAssetSourceRoot)' != '' and Exists('$(_BGCSPackageRoot)tools/clang-worker/common/BGCS.Frontend.Clang.Worker.dll')">$(NuGetPackageRoot)</BGCSNativePackageRoot>
  </PropertyGroup>
  <UsingTask TaskName="BGCS.MSBuild.GenerateBindingsTask"
             AssemblyFile="$(BGCSMSBuildTaskAssembly)"
             Runtime="NET" TaskFactory="TaskHostFactory"
             Condition="'$(BGCSMSBuildTaskAssembly)' != ''" />
  <UsingTask TaskName="BGCS.MSBuild.PrepareWorkerAssetsTask"
             AssemblyFile="$(BGCSMSBuildTaskAssembly)"
             Runtime="NET" TaskFactory="TaskHostFactory"
             Condition="'$(BGCSMSBuildTaskAssembly)' != ''" />
  <UsingTask TaskName="BGCS.MSBuild.ReadArtifactManifestTask"
             AssemblyFile="$(BGCSMSBuildTaskAssembly)"
             Runtime="NET" TaskFactory="TaskHostFactory"
             Condition="'$(BGCSMSBuildTaskAssembly)' != ''" />
  <UsingTask TaskName="BGCS.MSBuild.ClearBindingsTask"
             AssemblyFile="$(BGCSMSBuildTaskAssembly)"
             Runtime="NET" TaskFactory="TaskHostFactory"
             Condition="'$(BGCSMSBuildTaskAssembly)' != ''" />

  <Target Name="BGCSPrepareWorkerAssets" BeforeTargets="BGCSGenerateBindings;CopyFilesToOutputDirectory"
          Condition="'$(BGCSWorkerAssetSourceRoot)' != '' and '$(BGCSWorkerAssetManifest)' != '' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <BGCS.MSBuild.PrepareWorkerAssetsTask SourceRoot="$(BGCSWorkerAssetSourceRoot)"
                                         ManifestPath="$(BGCSWorkerAssetManifest)"
                                         NativePackageRoot="$(BGCSNativePackageRoot)"
                                         ParserRuntimeVersion="$(BGCSParserRuntimeVersion)"
                                         SupplementalRuntimeVersion="$(BGCSProductVersion)"
                                         AssemblyRoot="$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)bgcs-worker-assets', '$(MSBuildProjectDirectory)'))"
                                         DestinationRoot="$([System.IO.Path]::GetFullPath('$(OutputPath)bgcs/worker', '$(MSBuildProjectDirectory)'))">
      <Output TaskParameter="DeployedRoot" PropertyName="BGCSWorkerAssetRoot" />
    </BGCS.MSBuild.PrepareWorkerAssetsTask>
  </Target>

  <Target Name="BGCSGenerateBindings"
          BeforeTargets="CoreCompile"
          Condition="'$(BGCSGenerateBindings)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_BGCSOutputDirectory>$(IntermediateOutputPath)bgcs/$(RuntimeIdentifier)/$(BGCSNativeTarget)</_BGCSOutputDirectory>
    </PropertyGroup>
    <Error Condition="'$(BGCSMSBuildTaskAssembly)' == ''" Text="The BGCS SDK TaskHost assets are unavailable. Deploy the SDK assets before enabling generation." />
    <BGCS.MSBuild.GenerateBindingsTask ConfigFile="$(BGCSConfig)"
                                      ProjectDirectory="$(MSBuildProjectDirectory)"
                                      OutputDirectory="$(_BGCSOutputDirectory)"
                                      WorkerAssetRoot="$(BGCSWorkerAssetRoot)"
                                      NativeTarget="$(BGCSNativeTarget)">
      <Output TaskParameter="ArtifactManifest" PropertyName="BGCSArtifactManifest" />
      <Output TaskParameter="LibraryId" PropertyName="_BGCSLibraryId" />
    </BGCS.MSBuild.GenerateBindingsTask>
    <BGCS.MSBuild.ReadArtifactManifestTask OutputDirectory="$([System.IO.Path]::GetFullPath('$(_BGCSOutputDirectory)', '$(MSBuildProjectDirectory)'))" LibraryId="$(_BGCSLibraryId)">
      <Output TaskParameter="GeneratedFiles" ItemName="_BGCSGeneratedCompile" />
    </BGCS.MSBuild.ReadArtifactManifestTask>
    <ItemGroup>
      <Compile Remove="@(_BGCSGeneratedCompile)" />
      <Compile Include="@(_BGCSGeneratedCompile)" />
    </ItemGroup>
  </Target>

  <Target Name="BGCSClearOwnedIntermediates" BeforeTargets="CoreClean"
          Condition="'$(BGCSMSBuildTaskAssembly)' != '' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <BGCS.MSBuild.ClearBindingsTask ConfigFile="$(BGCSConfig)"
                                  ProjectDirectory="$(MSBuildProjectDirectory)"
                                  IntermediateRoot="$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)', '$(MSBuildProjectDirectory)'))"
                                  OutputDirectory="$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)bgcs/$(RuntimeIdentifier)/$(BGCSNativeTarget)', '$(MSBuildProjectDirectory)'))"
                                  ApplicationOutputRoot="$([System.IO.Path]::GetFullPath('$(OutputPath)', '$(MSBuildProjectDirectory)'))"
                                  WorkerOutputRoot="$([System.IO.Path]::GetFullPath('$(OutputPath)bgcs/worker', '$(MSBuildProjectDirectory)'))"
                                  WorkerSourceRoot="$(BGCSWorkerAssetSourceRoot)" />
  </Target>
</Project>
