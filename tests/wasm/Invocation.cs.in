    private static void Run__MODE__(__MODE__.NativeApi api)
    {
        Assert(api.Raw.BgcsAdd(19, -7) == 12, "__MODE__: scalar arguments/result.");
        m_checks.Add("__MODE__:scalar");
        Assert(api.Raw.BgcsUint64Transform(1UL << 60) == ((1UL << 60) | (1UL << 59)),
            "__MODE__: 64-bit integer arguments and return values preserve high bits.");
        m_checks.Add("__MODE__:wide-integer");
        Assert(sizeof(__MODE__.WideFlags) == 8 && SizeOf(api.Raw.BgcsWideFlagsTransform(0)) == 8 &&
            api.BgcsWideFlagsTransform(__MODE__.WideFlags.HighBit) == (__MODE__.WideFlags.HighBit | __MODE__.WideFlags.AddedBit) &&
            api.BgcsWideFlagsTransform(__MODE__.WideFlags.TopBit) == (__MODE__.WideFlags.TopBit | __MODE__.WideFlags.AddedBit) &&
            api.BgcsWideFlagsTransform(__MODE__.WideFlags.All) == (__MODE__.WideFlags.All ^ __MODE__.WideFlags.AddedBit) &&
            api.BgcsWideFlagsTransform(api.BgcsWideFlagsTransform(__MODE__.WideFlags.All)) == __MODE__.WideFlags.All &&
            api.Raw.BgcsWideFlagsTransform(ulong.MaxValue) == (ulong.MaxValue ^ (1UL << 59)),
            "__MODE__: generated 64-bit enum projection and unchanged native uint64 carrier preserve high bits.");
        m_checks.Add("__MODE__:wide-enum");
        Assert(api.Raw.BgcsLongSize() == SizeOf(api.Raw.BgcsLongTransform(0)) && api.Raw.BgcsLongTransform(-11) == -40,
            "__MODE__: target C long width and signed invocation.");
        m_checks.Add("__MODE__:native-long");
        Assert(api.Raw.BgcsBoolNot(0) == 1 && api.Raw.BgcsBoolNot(1) == 0,
            "__MODE__: native bool arguments and return value.");
        m_checks.Add("__MODE__:bool");
        static __SIZE_TYPE__ SizeOf<T>(T value) where T : unmanaged => (__SIZE_TYPE__)sizeof(T);

        int marker = 123;
        __MODE__.BgcsLayout layout = new() { tag = 5, value = -21, count = 8, context = &marker };
        Assert(api.Raw.BgcsPointerSize() == (__SIZE_TYPE__)sizeof(nint), "__MODE__: native pointer size.");
        Assert(api.Raw.BgcsLayoutSize() == (__SIZE_TYPE__)sizeof(__MODE__.BgcsLayout), "__MODE__: record size.");
        Assert(api.Raw.BgcsLayoutContextOffset() == (__SIZE_TYPE__)((byte*)&layout.context - (byte*)&layout), "__MODE__: record offset.");
        api.Raw.BgcsTransform(&layout);
        Assert(layout.tag == 6 && layout.value == -42 && layout.count == 11 && layout.context == &marker,
            "__MODE__: record round trip preserves context.");
        m_checks.Add("__MODE__:layout");
        __MODE__.BgcsBits bits = new() { count = 17, mode = (__MODE__.BgcsMode)2, delta = -123 };
        Assert(api.Raw.BgcsBitsSize() == (__SIZE_TYPE__)sizeof(__MODE__.BgcsBits) && api.Raw.BgcsBitsTransform(&bits) == 1 &&
            bits.count == 18 && bits.mode == (__MODE__.BgcsMode)1 && bits.delta == -246,
            "__MODE__: mixed signed, unsigned and enum bitfields round trip through native bytes.");
        m_checks.Add("__MODE__:bitfields");
        int* buffer = stackalloc int[3] { 2, 3, 5 };
        Assert(api.Raw.BgcsSum(buffer, 3) == 10, "__MODE__: input buffer.");
        __SIZE_TYPE__ written = 99;
        Assert(api.Raw.BgcsWrite(buffer, 3, &written) == 1 && written == 3, "__MODE__: output buffer count.");
        Assert(buffer[0] == 7 && buffer[1] == 11 && buffer[2] == 13, "__MODE__: output buffer values.");
        m_checks.Add("__MODE__:buffer");
        Assert(api.Raw.BgcsWrite(buffer, 2, &written) == 0 && written == 0 && buffer[0] == 7 && buffer[1] == 11 && buffer[2] == 13,
            "__MODE__: insufficient capacity must not write.");
        m_checks.Add("__MODE__:capacity");
        int rawAliased = 10;
        Assert(api.Raw.BgcsAliasRef(&rawAliased, &rawAliased) == 1022 && rawAliased == 22,
            "__MODE__: raw reference oracle observes identical native pointers and mutation order.");
        int aliased = 10;
        Assert(api.BgcsAliasRef(ref aliased, ref aliased) == 1022 && aliased == 22,
            "__MODE__: two generated ref arguments retain the original shared native address.");
        m_checks.Add("__MODE__:alias-ref");
        aliased = 10;
        Assert(api.BgcsAliasInOut(in aliased, out aliased) == 1013 && aliased == 13,
            "__MODE__: generated in/out arguments preserve the original aliased storage.");
        m_checks.Add("__MODE__:alias-in-out");
        __MODE__.BgcsLayout aliasedRecord = new() { tag = 5, value = 17, count = 8, context = &marker };
        Assert(api.BgcsAliasRecord(ref aliasedRecord, ref aliasedRecord.value) == 1010 && aliasedRecord.value == 10 &&
            aliasedRecord.tag == 5 && aliasedRecord.count == 8 && aliasedRecord.context == &marker,
            "__MODE__: record and field references retain their overlapping native addresses and unrelated fields.");
        m_checks.Add("__MODE__:alias-record-field");
        Span<int> overlap = stackalloc int[3] { 2, 3, 5 };
        Assert(api.BgcsAliasSpan(overlap, ref overlap[1]) == 1013 && overlap[0] == 2 && overlap[1] == 13 && overlap[2] == 5,
            "__MODE__: generated Span and ref inputs preserve their original overlapping storage.");
        m_checks.Add("__MODE__:alias-span-ref");
        Assert(api.Raw.BgcsLiveCount() == 0, "__MODE__: no outstanding allocation.");
        __MODE__.BgcsCounter* counter = api.Raw.BgcsCounterCreate(40);
        Assert(counter != null, "__MODE__: native allocation.");
        try
        {
            Assert(api.Raw.BgcsCounterNext(counter, 2) == 42 && api.Raw.BgcsLiveCount() == 1, "__MODE__: typed handle invocation.");
            m_checks.Add("__MODE__:handle");
            m_expectedCounter = (nint)counter;
            int callbacksBefore = m_callbacks;
            var callback = (delegate* unmanaged[Cdecl]<__MODE__.BgcsCounter*, int, void*, int>)(delegate* unmanaged[Cdecl]<void*, int, void*, int>)&Callback;
            Assert(api.Raw.BgcsInvokeCallback(counter, 10, callback, &marker) == 133 && m_callbacks == callbacksBefore + 1,
                "__MODE__: native callback signature and context.");
            m_checks.Add("__MODE__:callback");
            Assert(api.Raw.BgcsInvokeCallback(counter, 10, null, &marker) == -1 && m_callbacks == callbacksBefore + 1,
                "__MODE__: null callback is rejected natively.");
            m_checks.Add("__MODE__:null-callback");
            int managedCalls = 0;
            int managedOffset = marker;
            int managedResult = api.BgcsInvokeCallback(counter, 10, (nativeCounter, value) =>
            {
                Assert(nativeCounter == counter, "__MODE__: managed callback preserves the explicit native object pointer.");
                ++managedCalls;
                return value + managedOffset;
            });
            Assert(managedResult == 133 && managedCalls == 1 && m_callbacks == callbacksBefore + 1,
                "__MODE__: generated call-scoped managed callback uses its captured state through the native userdata protocol.");
            m_checks.Add("__MODE__:managed-callback");
            InvalidOperationException callbackFailure = new("__MODE__: managed callback failure.");
            bool callbackExceptionReturned = false;
            try { api.BgcsInvokeCallback(counter, 10, (_, _) => throw callbackFailure); }
            catch (InvalidOperationException failure) when (ReferenceEquals(failure, callbackFailure)) { callbackExceptionReturned = true; }
            Assert(callbackExceptionReturned && managedCalls == 1,
                "__MODE__: managed callback exception returns through the generated boundary after native invocation.");
            m_checks.Add("__MODE__:managed-callback-exception");
        }
        finally { api.Raw.BgcsCounterDestroy(counter); m_expectedCounter = 0; }
        api.Raw.BgcsCounterDestroy(null);
        Assert(api.Raw.BgcsCounterNext(null, 1) == -1 && api.Raw.BgcsLiveCount() == 0, "__MODE__: release and null handle.");
        m_checks.Add("__MODE__:release");

        Assert(CppLiveCount() == 0, "__MODE__: no outstanding C++ owner.");
        __MODE__.BridgeError* error = null;
        __MODE__.BridgeCounter* cppCounter = null;
        CheckStatus(api.Raw.BridgeCounterCreate(31, &cppCounter, &error), error, "construct");
        Assert(cppCounter != null && CppLiveCount() == 1, "__MODE__: C++ constructor crosses the generated bridge.");
        m_checks.Add("__MODE__:cpp-construction");
        try
        {
            Assert(CppRead(cppCounter) == 31, "__MODE__: C++ initial instance state.");
            int value = 0;
            error = null;
            CheckStatus(api.Raw.BridgeCounterAdd(cppCounter, 11, &value, &error), error, "method");
            Assert(value == 42 && CppRead(cppCounter) == 42, "__MODE__: C++ methods preserve instance state.");
            m_checks.Add("__MODE__:cpp-method");
            __MODE__.BridgeBaseB* baseB = null;
            error = null;
            CheckStatus(api.Raw.BridgeCounterAsBridgeBaseB(cppCounter, &baseB, &error), error, "base cast");
            __MODE__.BridgeCounter* restored = null;
            error = null;
            CheckStatus(api.Raw.BridgeCounterFromBridgeBaseB(baseB, &restored, &error), error, "derived cast");
            Assert(baseB != null && (void*)baseB != cppCounter && restored == cppCounter,
                "__MODE__: multiple inheritance adjusts and restores native addresses.");
            __MODE__.BridgeBaseB* unrelated = null;
            error = null;
            CheckStatus(api.Raw.BridgeBaseBCreate(&unrelated, &error), error, "unrelated constructor");
            try
            {
                restored = cppCounter;
                error = null;
                CheckStatus(api.Raw.BridgeCounterFromBridgeBaseB(unrelated, &restored, &error), error, "unrelated checked cast");
                Assert(restored == null, "__MODE__: checked downcast rejects an unrelated owner.");
            }
            finally { error = null; CheckStatus(api.Raw.BridgeBaseBDestroy(unrelated, &error), error, "unrelated destructor"); }
            m_checks.Add("__MODE__:cpp-inheritance");
        }
        finally { error = null; CheckStatus(api.Raw.BridgeCounterDestroy(cppCounter, &error), error, "destructor"); }
        error = null;
        CheckStatus(api.Raw.BridgeCounterDestroy(null, &error), error, "null destructor");
        Assert(CppLiveCount() == 0, "__MODE__: C++ destructor releases its owner and accepts a null handle.");
        m_checks.Add("__MODE__:cpp-release");

        int CppLiveCount()
        {
            int value = -1; __MODE__.BridgeError* failure = null;
            CheckStatus(api.Raw.BridgeCounterLiveCount(&value, &failure), failure, "live count");
            return value;
        }
        int CppRead(__MODE__.BridgeCounter* instance)
        {
            int value = 0; __MODE__.BridgeError* failure = null;
            CheckStatus(api.Raw.BridgeCounterRead(instance, &value, &failure), failure, "read");
            return value;
        }
        void CheckStatus(int status, __MODE__.BridgeError* failure, string operation)
        {
            try
            {
                string? message = failure == null ? null : Marshal.PtrToStringUTF8((nint)api.Raw.BridgeErrorMessage(failure));
                Assert(status == 0 && failure == null, "__MODE__: C++ " + operation + " status=" + status + ": " + message);
            }
            finally { if (failure != null) api.Raw.BridgeErrorRelease(failure); }
        }
    }
