using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;
using System.Runtime.InteropServices.JavaScript;
using System.Text;
using System.Text.Json;
using System.Text.Json.Serialization;
using BGCS.Runtime;

namespace WasmAcceptance;

internal static unsafe partial class Program
{
    private static readonly List<string> m_checks = [];
    private static string m_report = "{}";
    private static nint m_expectedCounter;
    private static int m_callbacks;

    private static int Main()
    {
        try
        {
            Assert(sizeof(nint) == 4, "The consumer must execute inside wasm32.");
            RunDllImport();
            RunLibraryImport();
            WasmSymbolContext context = new();
            Assert(!context.TryGetProcAddress("missing_symbol", out nint missing) && missing == 0,
                "A missing symbol must remain unresolved.");
            m_checks.Add("missing-symbol");
            FunctionTable.NativeApi.InitApi(context);
            WasmSymbolContext failing = new("bgcs_add");
            bool rejected = false;
            try {
                FunctionTable.NativeApi.InitApi(failing);
            }
            catch (EntryPointNotFoundException) {
                rejected = true;
            }
            Assert(rejected && failing.disposeCount == 1 && context.disposeCount == 0 &&
                FunctionTable.NativeApi.BgcsAdd(3, 4) == 7,
                "A failed table candidate must release its context and preserve the current table.");
            m_checks.Add("failed-initialization");
            try
            {
                RunFunctionTable();
            }
            finally
            {
                FunctionTable.NativeApi.FreeApi();
                FunctionTable.NativeApi.FreeApi();
            }
            Assert(context.disposeCount == 1, "The generated table must dispose its context once.");
            m_checks.Add("function-table-context");
            VerifyBorrowedResources();
            m_report = SerializeReport(true, null);
            Console.WriteLine(m_report);
            return 0;
        }
        catch (Exception exception)
        {
            m_report = SerializeReport(false, exception.ToString());
            Console.Error.WriteLine(m_report);
            return 1;
        }
    }

    /// <summary>
    /// Returns the completed invocation report to the fixture's JavaScript host.
    /// </summary>
    /// <returns>
    /// JSON containing the executed checks and any failure, or an empty object before Main completes.
    /// </returns>
    [JSExport]
    public static string GetReport() => m_report;

    private static string SerializeReport(
        bool success,
        string? error
    ) => JsonSerializer.Serialize(new InvocationReport(success, sizeof(nint), m_checks.ToArray(), error),
        ReportContext.Default.InvocationReport);

    private static void VerifyBorrowedResources() {
        WasmSymbolContext borrowedContext = new();
        using (BGCS.Runtime.FunctionTable table = new(borrowedContext, 1, ownsContext: false)) {
            table.LoadRequired(0, "bgcs_add");
            Assert(((delegate* unmanaged[Cdecl]<int, int, int>)table[0])(2, 5) == 7,
                "Borrowed context invocation.");
        }
        Assert(borrowedContext.disposeCount == 0, "Disposing a table must preserve its borrowed context.");
        m_checks.Add("borrowed-context");
        void** slots = stackalloc void*[1];
        slots[0] = (void*)borrowedContext.GetProcAddress("bgcs_add");
        using (BGCS.Runtime.FunctionTable table = new(slots, 1))
            Assert(((delegate* unmanaged[Cdecl]<int, int, int>)table[0])(1, 8) == 9, "Borrowed storage invocation.");
        Assert(((delegate* unmanaged[Cdecl]<int, int, int>)slots[0])(4, 5) == 9,
            "Disposing a table must preserve its borrowed pointer storage.");
        borrowedContext.Dispose();
        Assert(borrowedContext.disposeCount == 1, "The external owner releases its context.");
        m_checks.Add("borrowed-storage");
    }

    [UnmanagedCallersOnly(CallConvs = [typeof(CallConvCdecl)])]
    private static int Callback(
        nint counter,
        int value,
        void* state
    ) {
        m_callbacks++;
        return counter == m_expectedCounter ? value + *(int*)state : int.MinValue;
    }

    private static void Assert(
        bool condition,
        string message
    ) {
        if (!condition)
            throw new InvalidOperationException(message);
    }

__RUNNERS__

    private sealed class WasmSymbolContext : INativeContext
    {
        private readonly string? m_missingExport;

        internal WasmSymbolContext(string? missingExport = null) => m_missingExport = missingExport;

        /// <summary>
        /// Gets the number of ownership releases performed by the generated function table.
        /// </summary>
        public int disposeCount { get; private set; }

        /// <inheritdoc />
        public nint GetProcAddress(string procName)
        {
            if (procName == m_missingExport)
                return 0;
            byte[] name = Encoding.UTF8.GetBytes(procName + "\0");
            fixed (byte* pointer = name)
                return (nint)DllImport.NativeApi.BgcsResolve(pointer);
        }

        /// <inheritdoc />
        public bool TryGetProcAddress(
            string procName,
            out nint procAddress
        ) {
            procAddress = GetProcAddress(procName);
            return procAddress != 0;
        }

        /// <inheritdoc />
        public bool IsExtensionSupported(string extensionName) => false;

        /// <inheritdoc />
        public void Dispose() => disposeCount++;
    }
}

internal sealed record InvocationReport(
    bool success,
    int pointerSize,
    string[] checks,
    string? error
);

[JsonSerializable(typeof(InvocationReport))]
internal partial class ReportContext : JsonSerializerContext { }
