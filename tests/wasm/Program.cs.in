using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;
using System.Text;
using System.Text.Json;
using System.Text.Json.Serialization;
using BGCS.Runtime;
__BROWSER_USING__

namespace __NAMESPACE__;

internal static unsafe partial class Program
{
    private static readonly List<string> m_checks = [];
    private static readonly Dictionary<string, string> m_aggregateSignatures = [];
    private static string m_report = "{}";
    private static string[] m_lifecycleChecks = [];
    private static nint m_expectedCounter;
    private static int m_callbacks;

    __ENTRY_POINT__

    private static int RunBaseline()
    {
        try
        {
            __MAIN_ASSERTION__
            using DllImport.NativeApi dll = DllImport.NativeApi.Create();
            using LibraryImport.NativeApi library = LibraryImport.NativeApi.Create();
            RunDllImport(dll);
            RunLibraryImport(library);
            __AGGREGATE_DIRECT_CHECKS__
            SymbolProvider context = new();
            Assert(!context.TryGetExport("missing_symbol", out nint missing) && missing == 0, "A missing symbol must remain unresolved.");
            m_checks.Add("missing-symbol");
            FunctionTable.NativeApi api = FunctionTable.NativeApi.FromProvider(context);
            SymbolProvider failing = new("bgcs_add");
            bool rejected = false;
            try { using var failed = FunctionTable.NativeApi.FromProvider(failing); }
            catch (EntryPointNotFoundException) { rejected = true; }
            Assert(rejected && failing.disposeCount == 1 && context.disposeCount == 0 && api.Raw.BgcsAdd(3, 4) == 7,
                "A failed table candidate must release its provider and preserve the existing instance.");
            m_checks.Add("failed-initialization");
            try { RunFunctionTable(api); __AGGREGATE_TABLE_CHECKS__ __STATIC_ADAPTER_CHECK__ }
            finally { api.Dispose(); api.Dispose(); }
            Assert(context.disposeCount == 1, "The generated context must dispose its owned provider once.");
            bool closed = false;
            try { api.Raw.BgcsAdd(1, 2); }
            catch (ObjectDisposedException) { closed = true; }
            Assert(closed, "A disposed API must reject new calls.");
            m_checks.Add("function-table-context");
            VerifyBorrowedResources();
            m_report = SerializeReport(true, null);
            __BASELINE_PRINT__
            return 0;
        }
        catch (Exception exception)
        {
            m_report = SerializeReport(false, exception.ToString());
            __BASELINE_PRINT__
            return 1;
        }
    }

    __BROWSER_EXPORT__

    __BROWSER_LIFECYCLE_REPORT__

    private static string SerializeReport(bool success, string? error) => JsonSerializer.Serialize(
        new InvocationReport(success, sizeof(nint), m_checks.ToArray(), error, m_aggregateSignatures, m_lifecycleChecks), ReportContext.Default.InvocationReport);

    private static void VerifyBorrowedResources()
    {
        SymbolProvider external = new();
        using (NativeModuleSession session = new(new BorrowedProvider(external)))
        {
            var symbols = session.ResolveRequiredSymbols(["bgcs_add"]);
            Assert(((delegate* unmanaged[Cdecl]<int, int, int>)symbols["bgcs_add"])(2, 5) == 7, "Borrowed provider invocation.");
        }
        Assert(external.disposeCount == 0, "Disposing a session must preserve the external owner of a borrowed provider.");
        m_checks.Add("borrowed-context");
        Assert(external.TryGetExport("bgcs_add", out nint add), "The external owner still supplies its native export.");
        nint* slots = stackalloc nint[1] { add };
        ReleaseLease lease = new();
        const string identity = "fixture:bgcs_add:cdecl:i32(i32,i32)";
        using (ExternalFunctionTableProvider table = new(identity, identity, ["bgcs_add"], new ReadOnlySpan<nint>(slots, 1), lease))
        {
            Assert(table.TryGetExport("bgcs_add", out nint address) &&
                ((delegate* unmanaged[Cdecl]<int, int, int>)address)(1, 8) == 9, "Borrowed pointer storage invocation.");
        }
        Assert(slots[0] == add && ((delegate* unmanaged[Cdecl]<int, int, int>)slots[0])(4, 5) == 9 && lease.disposeCount == 1,
            "External table disposal releases its lease once and preserves caller-owned pointer storage.");
        Assert(external.disposeCount == 0, "Borrowed pointer storage must preserve its external module.");
        external.Dispose();
        Assert(external.disposeCount == 1, "The external owner releases its provider.");
        m_checks.Add("borrowed-storage");
    }

    [UnmanagedCallersOnly(CallConvs = [typeof(CallConvCdecl)])]
    private static int Callback(void* counter, int value, void* state)
    {
        m_callbacks++;
        return (nint)counter == m_expectedCounter ? value + *(int*)state : int.MinValue;
    }

    private static void Assert(bool condition, string message)
    {
        if (!condition) throw new InvalidOperationException(message);
    }

__RUNNERS__

    private sealed class SymbolProvider(string? missingExport = null) : INativeModuleProvider
    {
        internal int disposeCount { get; private set; }
        public bool TryGetExport(string name, out nint address)
        {
            ObjectDisposedException.ThrowIf(disposeCount != 0, this);
            if (name == missingExport) { address = 0; return false; }
            byte[] encoded = Encoding.UTF8.GetBytes(name + "\0");
            using DllImport.NativeApi resolver = DllImport.NativeApi.Create();
            fixed (byte* pointer = encoded) address = (nint)resolver.Raw.BgcsResolve((sbyte*)pointer);
            return address != 0;
        }
        public void Dispose() => disposeCount++;
    }

    private sealed class BorrowedProvider(INativeModuleProvider external) : INativeModuleProvider
    {
        public bool TryGetExport(string name, out nint address) => external.TryGetExport(name, out address);
        public void Dispose() { }
    }

    private sealed class ReleaseLease : IDisposable
    {
        internal int disposeCount { get; private set; }
        public void Dispose() => disposeCount++;
    }
}

internal sealed record InvocationReport(bool success, int pointerSize, string[] checks, string? error, Dictionary<string, string> aggregateSignatures, string[] lifecycleChecks);
[JsonSerializable(typeof(InvocationReport))]
internal partial class ReportContext : JsonSerializerContext { }
