<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AssemblyName>BGCS.Wasm.TypedBridge</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <WasmBuildNative>true</WasmBuildNative>
    <PublishTrimmed>false</PublishTrimmed>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DisableParallelAot>true</DisableParallelAot>
    <DisableParallelEmccCompile>true</DisableParallelEmccCompile>
    <EmccExtraCFlags>-I&quot;$(MSBuildProjectDirectory)/Native&quot;</EmccExtraCFlags>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BGCS.Runtime"><HintPath>BGCS.Runtime.dll</HintPath></Reference>
    <NativeFileReference Include="Native/native.c" />
  </ItemGroup>
</Project>
