<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Compilation">
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Label="Package dependencies">
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup Label="Project dependencies">
    <ProjectReference Include="../../src/BGCS.Runtime/BGCS.Runtime.csproj" />
    <ProjectReference Include="../../src/BGCS/BGCS.csproj" />
    <ProjectReference Include="../../src/BGCS.Frontend.Clang.Worker/BGCS.Frontend.Clang.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Label="Test inputs">
    <None Update="groupedEntryTests/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="entryTests/**/*.h">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="entryTests/**/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
