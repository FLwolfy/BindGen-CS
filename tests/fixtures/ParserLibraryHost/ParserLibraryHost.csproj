<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Compilation">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup Label="Project dependencies">
    <ProjectReference Include="../../../src/BGCS.Frontend.Clang/BGCS.Frontend.Clang.csproj" />
    <ProjectReference Include="../../../src/BGCS.Platforms/BGCS.Platforms.csproj" />
  </ItemGroup>

  <Target Name="StageConfiguredParserRuntime" AfterTargets="Build" Condition="'$(BGCS_CLANG_RUNTIME_DIR)' != ''">
    <ItemGroup>
      <_ParserNativeRuntime Include="$(BGCS_CLANG_RUNTIME_DIR)/*.dll;$(BGCS_CLANG_RUNTIME_DIR)/*.so*;$(BGCS_CLANG_RUNTIME_DIR)/*.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(_ParserNativeRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
