<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Compilation">
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup Label="Project dependencies">
    <ProjectReference Include="../../../src/BGCS.CppAst/BGCS.CppAst.csproj" />
  </ItemGroup>

  <ItemGroup Label="Package dependencies">
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.12.50" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="StageConfiguredParserRuntime" AfterTargets="Build" Condition="'$(BGCS_CLANG_RUNTIME_DIR)' != ''">
    <ItemGroup>
      <_ParserNativeRuntime Include="$(BGCS_CLANG_RUNTIME_DIR)/*.dll;$(BGCS_CLANG_RUNTIME_DIR)/*.so*;$(BGCS_CLANG_RUNTIME_DIR)/*.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(_ParserNativeRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
