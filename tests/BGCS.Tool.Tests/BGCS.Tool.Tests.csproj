<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Compilation">
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Label="Package dependencies">
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup Label="Project dependencies">
    <ProjectReference Include="../../src/BGCS.Tool/BGCS.Tool.csproj" />
    <ProjectReference Include="../../examples/CustomTargetPlugin/BGCS.Example.CustomTargetPlugin.csproj" />
    <ProjectReference Include="../../src/BGCS.Frontend.Clang.Worker/BGCS.Frontend.Clang.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="BGCSDeployCliTestWorker" AfterTargets="Build">
    <ItemGroup>
      <_BGCSCliWorker Include="../../src/BGCS.Frontend.Clang.Worker/bin/$(Configuration)/net10.0/*.dll;../../src/BGCS.Frontend.Clang.Worker/bin/$(Configuration)/net10.0/*.json" />
      <_BGCSCliWorkerNative Include="../../src/BGCS.Frontend.Clang.Worker/bin/$(Configuration)/net10.0/runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BGCSCliWorker)" DestinationFolder="$(TargetDir)bgcs/worker" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_BGCSCliWorkerNative)" DestinationFolder="$(TargetDir)bgcs/worker/runtimes/$(NETCoreSdkRuntimeIdentifier)/native" SkipUnchangedFiles="true" />
  </Target>
</Project>
