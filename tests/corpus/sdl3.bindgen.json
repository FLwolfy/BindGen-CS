{
  "$schema": "../../schemas/bindgen.schema.json",
  "schemaVersion": 2,
  "library": {
    "id": "sdl3",
    "nativeName": "SDL3"
  },
  "source": {
    "language": "c",
    "languageStandard": "c17",
    "includeHeaderHelpers": true,
    "headers": [
      "../../artifacts/corpus/headers/SDL/include/SDL3/SDL.h"
    ],
    "includeDirectories": [
      "../../artifacts/corpus/headers/SDL/include"
    ],
    "includeTransitivelyReferencedHeaders": true,
    "selection": {
      "excludeDeclarations": [
        "SDL_sscanf",
        "SDL_snprintf",
        "SDL_swprintf",
        "SDL_asprintf",
        "SDL_SetError",
        "SDL_IOprintf",
        "SDL_Log",
        "SDL_LogTrace",
        "SDL_LogVerbose",
        "SDL_LogDebug",
        "SDL_LogInfo",
        "SDL_LogWarn",
        "SDL_LogError",
        "SDL_LogCritical",
        "SDL_LogMessage",
        "SDL_RenderDebugTextFormat",
        "SDL_size_add_check_overflow_builtin",
        "SDL_size_mul_check_overflow_builtin"
      ]
    },
    "defines": []
  },
  "api": {
    "namespace": "BGCS.RealLibraries.SDL3",
    "name": "SDL3",
    "style": "instance",
    "importMode": "functionTable",
    "framework": "net10.0",
    "names": {
      "SDL_GetVersion": "CorpusVersion",
      "SDL_abs": "CorpusAbsolute",
      "SDL_GetRevision": "CorpusRevision"
    },
    "runtime": "dotnet.coreclr"
  },
  "runtime": {
    "mode": "package"
  },
  "output": {
    "root": "Generated",
    "layout": "singleFile"
  }
}
